<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9C4">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:navigationIconTint="#333333"
        app:titleTextColor="#333333"/>

    <!-- Color Picker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Warna: "
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginEnd="8dp"/>

        <View android:id="@+id/dot0" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_0" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot1" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_1" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot2" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_2" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot3" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_3" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot4" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_4" android:layout_marginEnd="8dp"/>
        <View android:id="@+id/dot5" android:layout_width="26dp" android:layout_height="26dp"
            android:background="@drawable/dot_color_5"/>

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <!-- Tombol Dikte -->
        <TextView
            android:id="@+id/btnDictate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_dictate"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="🎙️ Dikte"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <!-- AI Loading bar -->
    <LinearLayout
        android:id="@+id/aiLoadingView"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#33FF7043"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ AI sedang merapikan teks kamu..."
            android:textSize="12sp"
            android:textColor="#BF360C"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:fontFamily="sans-serif-medium"
        android:hint="Judul catatan..."
        android:inputType="textCapSentences"
        android:maxLines="2"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:textColor="#2D2D2D"
        android:textColorHint="#BBBBBB"
        android:textSize="24sp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginHorizontal="20dp"
        android:background="#33000000"/>

    <EditText
        android:id="@+id/etContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@null"
        android:gravity="top"
        android:hint="Tulis catatanmu di sini... ✍️"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingMultiplier="1.6"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:scrollbars="vertical"
        android:textColor="#2D2D2D"
        android:textColorHint="#BBBBBB"
        android:textSize="16sp"/>

</LinearLayout>
